# Copie para .env e preencha com uma chave real. Nunca commitar o .env.
# Chave da Groq (console.groq.com) — usada pelo fallback de IA do
# Assistente de Consultas (fallback_ia/ia_fallback.py).
GROQ_API_KEY=

# Origem do front permitida a chamar o backend em dev (Vite).
# Tem de casar com `server.port` do assistente-consultas/vite.config.js, que
# é fixo e com strictPort — se divergir, o navegador descarta as respostas
# em silêncio e o assistente cai no modo local sem acusar erro.
FRONTEND_ORIGIN=http://localhost:5173
