# SQL Server local (SQL Express com TCP/IP na porta 1433, banco holder, autenticação do Windows).
# Requer `pip install -e "backend[sqlserver]"` (pyodbc) e o ODBC Driver 18 for SQL Server.
DATABASE_URL=mssql+pyodbc://@localhost:1433/holder?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# Alternativa sem servidor (arquivo SQLite local):
# DATABASE_URL=sqlite:///./holder.db
JWT_SECRET=trocar-em-producao-use-uma-chave-longa-e-aleatoria
JWT_EXPIRA_MINUTOS=480
CORS_ORIGENS=http://localhost:8501,http://localhost:5173
CAPACIDADE_FILA=10
LIMIAR_CRITICO=0.55
LIMIAR_ATENCAO=0.30
LIMIAR_MONITORAR=0.15
# Só tem efeito no primeiro seed do catálogo de sinais (configuracoes_sinal); depois disso,
# altere o valor de cada sinal direto na tabela.
PERSISTENCIA_MIN_MESES=2
CAMINHO_XLSX=../INOVAAPPS_base_de_dados.xlsx
